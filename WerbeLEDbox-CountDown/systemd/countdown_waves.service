[Unit]
Description=Hotel Anker countdown (waves → shm://ws2812; attach-only)
After=ws2812put-pi02.service
Requires=ws2812put-pi02.service

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/WerbeLEDbox-CountDown
Environment=FPS=25
# Producer MUST attach only — never create (create unlinks putter SHM → frozen/half panel)
ExecStart=/home/user/WerbeLEDbox-CountDown/.venv/bin/python /home/user/WerbeLEDbox-CountDown/scripts/countdown_waves_64.py --shm --fps 25
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
