[Unit]
Description=Hotel Anker countdown (gold on navy waves → shm://ws2812)
After=ws2812put-pi02.service
Wants=ws2812put-pi02.service

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/WerbeLEDbox-CountDown
Environment=FPS=25
Environment=ACTIVE_FIELDS=2
ExecStart=/home/user/WerbeLEDbox-CountDown/.venv/bin/python /home/user/WerbeLEDbox-CountDown/scripts/countdown_waves_64.py --shm --fps 25
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
