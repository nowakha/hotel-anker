[Unit]
Description=AnkerPI02 Hotel Anker boot splash → /dev/fb0
# Not on sysinit. No udev-settle. Wait for /dev/fb0 in ExecStartPre.
After=local-fs.target
Before=fb-clock.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=user
Group=user
SupplementaryGroups=video
WorkingDirectory=/home/user/WerbeLEDbox-CountDown
ExecStartPre=/bin/bash -c 'for i in $(seq 1 40); do [ -e /dev/fb0 ] && exit 0; sleep 0.25; done; exit 1'
ExecStart=/usr/bin/python3 /home/user/WerbeLEDbox-CountDown/scripts/fb_show_splash.py
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target
