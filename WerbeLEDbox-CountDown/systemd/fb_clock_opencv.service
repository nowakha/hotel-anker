[Unit]
Description=AnkerPI02 24h clock video via OpenCV → /dev/fb0
Documentation=file:/home/user/WerbeLEDbox-CountDown/docs/ANKERPI02.md
After=network-online.target time-sync.target systemd-timesyncd.service
Wants=network-online.target time-sync.target
After=local-fs.target

[Service]
Type=simple
User=user
Group=user
SupplementaryGroups=video render
WorkingDirectory=/home/user/WerbeLEDbox-CountDown
Environment=TZ=Europe/Zurich
Environment=VIDEO=/home/user/WerbeLEDbox-CountDown/media/st24.mov
ExecStartPre=/bin/bash -c 'for i in $(seq 1 120); do timedatectl show -p NTPSynchronized --value | grep -qx yes && exit 0; sleep 1; done; echo "warn: starting without NTP sync" >&2; exit 0'
# Hybrid: ffmpeg 1-frame seek + vf crop/scale + PIL NN upsample → RGB565 fb0
# OpenCV VideoCapture SIGBUS on st24 — do not use. Pipeline vf860 (bench winner).
# Stutter OK — always jump to wall-clock time (Europe/Zurich)
# nice+single-core: this Pi logs undervoltage under heavy 4K decode
Nice=10
CPUAffinity=0
# System python3 + python3-pil + python3-numpy
# min-interval 15s safer for weak PSU; player default is 0 (max fps) for foreground tests
ExecStart=/usr/bin/python3 /home/user/WerbeLEDbox-CountDown/fb_clock_opencv.py --video ${VIDEO} --tz Europe/Zurich --crop-top 386 --crop-bottom 127 --crop-left 0 --crop-right 0 --pipeline vf860 --hwaccel drm --log-every 1 --min-interval 15.0
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
