[Unit]
Description=AnkerPI02 24h clock video (wall-clock synced → /dev/fb0)
Documentation=file:/home/user/WerbeLEDbox-CountDown/docs/ANKERPI02.md
After=network-online.target time-sync.target systemd-timesyncd.service
Wants=network-online.target time-sync.target
# Do not start before HDMI/fb is up
After=local-fs.target

[Service]
Type=simple
User=user
Group=user
SupplementaryGroups=video render
WorkingDirectory=/home/user/WerbeLEDbox-CountDown
Environment=TZ=Europe/Zurich
# Production: pre-cropped/scaled 860x360 H.264 (-g 25). Crop already baked into encode.
Environment=VIDEO=/home/user/WerbeLEDbox-CountDown/media/clock_24h.mp4
# Prefer I/O for large sequential MP4 reads (occasional SD stalls → visible hitch).
ExecStartPre=/bin/bash -c 'for i in $(seq 1 120); do timedatectl show -p NTPSynchronized --value | grep -qx yes && exit 0; sleep 1; done; echo "warn: starting without NTP sync" >&2; exit 0'
# "+" = run as root despite User= (sysfs write needs root; "-" = ignore failure)
ExecStartPre=-+/bin/bash -c 'echo 8192 > /sys/block/mmcblk0/queue/read_ahead_kb 2>/dev/null || true'
# Continuous play; resync on real ffmpeg out_time drift (not mono estimate).
# fps=12 before upscale eases thermal lag (Pi soft-temp ~82–85°C under 25fps scale).
# seek-lead cancels ~1.4s v4l2m2m/fbdev pipeline latency so wall sync is real.
# Flip 180° at 860×360 then neighbor×4 to 3440×1440. Fallback: player auto --no-hw after HW fails.
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=0
ExecStart=/usr/bin/python3 /home/user/WerbeLEDbox-CountDown/fb_clock_play.py --video ${VIDEO} --tz Europe/Zurich --max-drift 0.5 --drift-check 2 --grace 5 --seek-lead 1.4 --max-fps 12 --log-drift-every 60 --resync-every 0
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
