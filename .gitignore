# OS generated
.DS_Store
Thumbs.db
Desktop.ini

# Editors / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Local env overrides (credentials live under WerbeLEDbox-CountDown/secrets/ by project request)
.env
.env.*
!.env.example

# Dependencies / build
node_modules/
dist/
build/
out/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Misc
*.tmp
*.temp

# Large clock / scratch media (keep README + splash + recovery cmdline)
WerbeLEDbox-CountDown/media/*.mov
WerbeLEDbox-CountDown/media/*.mp4
WerbeLEDbox-CountDown/media/clock_24h.mp4
WerbeLEDbox-CountDown/media/st24.mov
WerbeLEDbox-CountDown/media/_encode*
WerbeLEDbox-CountDown/media/_scp*

# PlatformIO build cache (source + platformio.ini stay tracked)
**/.pio/

# Font extract cache (keep curated TTFs + zip in fonts/)
WerbeLEDbox-CountDown/fonts/_extract/

# Local PI02 rescue watcher log (do not track)
WerbeLEDbox-CountDown/docs/_pi02_rescue.log
